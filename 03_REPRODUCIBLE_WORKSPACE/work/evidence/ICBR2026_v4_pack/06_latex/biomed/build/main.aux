\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Nondegenerate linear-Gaussian positive control.} All 144 target/design evaluations from 12 independent linear systems compare the analytic MAP MSE (horizontal) with the Monte Carlo MSE from 8,192 draws per system (vertical); the dashed identity line is the analytic reference. The independent unit is the system (n = 12); the 144 points are evaluations within systems, not independent neural networks, and no confidence intervals are displayed. Agreement validates this computational special case only; it does not validate biological assumptions.}}{23}{figure.S5}\protected@file@percent }
\newlabel{sfig:5}{{S5}{23}{\textbf {Nondegenerate linear-Gaussian positive control.} All 144 target/design evaluations from 12 independent linear systems compare the analytic MAP MSE (horizontal) with the Monte Carlo MSE from 8,192 draws per system (vertical); the dashed identity line is the analytic reference. The independent unit is the system (n = 12); the 144 points are evaluations within systems, not independent neural networks, and no confidence intervals are displayed. Agreement validates this computational special case only; it does not validate biological assumptions}{figure.S5}{}}
