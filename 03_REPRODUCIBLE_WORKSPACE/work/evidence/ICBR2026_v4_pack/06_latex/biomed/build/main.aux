\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The three-step audit.} Two criteria, nominal and prior-averaged local risk, each select a recording set from the same design pool. Step 1 asks whether the two sets are identical; if they are, the common maximum a posteriori fit sees the same data and the response error cannot differ. Step 2 compares the response error of the fitted prediction against hidden truth (mean-MSE change with the 97.5\% interval for the single-response and shared objectives; both intervals include zero). Step 3 fixes the data and the point prediction and compares the two risk forecasts v of the error e with the score log v + e\textsuperscript  {2}/v (95\% interval includes zero). The counts, effects and intervals are those of Figs. 3--4 and Table 1; the dot and bar icons for the recording sets and for v and e\textsuperscript  {2} are illustrative and carry no data. Negative differences favour the prior-averaged criterion.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:1}{{1}{4}{\textbf {The three-step audit.} Two criteria, nominal and prior-averaged local risk, each select a recording set from the same design pool. Step 1 asks whether the two sets are identical; if they are, the common maximum a posteriori fit sees the same data and the response error cannot differ. Step 2 compares the response error of the fitted prediction against hidden truth (mean-MSE change with the 97.5\% interval for the single-response and shared objectives; both intervals include zero). Step 3 fixes the data and the point prediction and compares the two risk forecasts v of the error e with the score log v + e\textsuperscript {2}/v (95\% interval includes zero). The counts, effects and intervals are those of Figs. 3--4 and Table 1; the dot and bar icons for the recording sets and for v and e\textsuperscript {2} are illustrative and carry no data. Negative differences favour the prior-averaged criterion}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Prior averaging often selects the same recordings and did not establish lower error in the primary comparisons}{4}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Connectivity, limited recordings and a held-out response in one simulated network.} \textbf  {a,} Known signed connectivity J for the first frozen network, J5000 (blue positive, orange negative weights; symmetric colour limits ±0.42 around exact zero); columns are presynaptic and rows postsynaptic nodes. Filled markers beside the matrix identify the recorded nodes N6, N8 and N11, the open vermilion marker the unrecorded readout N4, and the open plum marker the stimulated node N0. \textbf  {b,} Actual noisy calibration observations at the three recorded nodes in two trials, each reset to the same known initial state (Gaussian observation noise SD 0.05, stride 4). Trial 2 is shifted by 6 model-time units for display; the dashed line marks the trial boundary, not continuous evolution, and lines connect observations only within a trial. Vertical scales differ between nodes. \textbf  {c,} Stimulated minus matched zero-input control rate at N4 (displayed in units of 10\textsuperscript  {−4}); the upper strip shows the stimulus input at N0 during model time 1 to 2. The integrated response q = 2.43518 × 10\textsuperscript  {−4} (a.u. × model time) is Δt times the sum of the 120 frozen-model differences (Δt = 0.05), not a new trapezoidal integral. The case is the fixed first-index instance (broad uncertainty, truth and noise draw 0, target 0, endpoints excluded, M = 3, nominal single-response selection), chosen before its effect was inspected. Independent n = 1 network; no interval is shown and no between-method effect or biological validity is claimed. All quantities are in dimensionless model units.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:2}{{2}{5}{\textbf {Connectivity, limited recordings and a held-out response in one simulated network.} \textbf {a,} Known signed connectivity J for the first frozen network, J5000 (blue positive, orange negative weights; symmetric colour limits ±0.42 around exact zero); columns are presynaptic and rows postsynaptic nodes. Filled markers beside the matrix identify the recorded nodes N6, N8 and N11, the open vermilion marker the unrecorded readout N4, and the open plum marker the stimulated node N0. \textbf {b,} Actual noisy calibration observations at the three recorded nodes in two trials, each reset to the same known initial state (Gaussian observation noise SD 0.05, stride 4). Trial 2 is shifted by 6 model-time units for display; the dashed line marks the trial boundary, not continuous evolution, and lines connect observations only within a trial. Vertical scales differ between nodes. \textbf {c,} Stimulated minus matched zero-input control rate at N4 (displayed in units of 10\textsuperscript {−4}); the upper strip shows the stimulus input at N0 during model time 1 to 2. The integrated response q = 2.43518 × 10\textsuperscript {−4} (a.u. × model time) is Δt times the sum of the 120 frozen-model differences (Δt = 0.05), not a new trapezoidal integral. The case is the fixed first-index instance (broad uncertainty, truth and noise draw 0, target 0, endpoints excluded, M = 3, nominal single-response selection), chosen before its effect was inspected. Independent n = 1 network; no interval is shown and no between-method effect or biological validity is claimed. All quantities are in dimensionless model units}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Frozen primary response-error comparisons}}{6}{table.1}\protected@file@percent }
\newlabel{tab:1}{{1}{6}{Frozen primary response-error comparisons}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Prior averaging often selects the same recordings; primary error comparisons remain uncertain.} \textbf  {a,} Each dot is one recording design from the frozen first evaluation (120 single-response designs, three per network; 40 shared designs). Grey dots are designs in which the nominal and ensemble criteria chose identical recording sets; coloured dots are designs in which they differed (82/120 and 26/40 identical). \textbf  {b,} Descriptive within-network log\textsubscript  {2} ratio of ensemble to nominal MSE for the 40 independent networks per objective; the hollow marker at zero stands for networks with exactly equal MSE (13 single-response, 26 three-response), and filled points are the remaining networks. Three truths, three noise repetitions and three readouts are averaged within each network. These ratios are neither the primary estimand nor the ratio of aggregate means. \textbf  {c,} Relative change in aggregate mean MSE, ensemble versus nominal, with the prespecified 97.5\% paired network-cluster bootstrap intervals (same estimates as Table 1). Negative values favour the ensemble. All networks, including influential instances, are retained; Supplementary Fig. 1 shows the complete raw difference distributions. No method-equivalence margin was specified.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:3}{{3}{6}{\textbf {Prior averaging often selects the same recordings; primary error comparisons remain uncertain.} \textbf {a,} Each dot is one recording design from the frozen first evaluation (120 single-response designs, three per network; 40 shared designs). Grey dots are designs in which the nominal and ensemble criteria chose identical recording sets; coloured dots are designs in which they differed (82/120 and 26/40 identical). \textbf {b,} Descriptive within-network log\textsubscript {2} ratio of ensemble to nominal MSE for the 40 independent networks per objective; the hollow marker at zero stands for networks with exactly equal MSE (13 single-response, 26 three-response), and filled points are the remaining networks. Three truths, three noise repetitions and three readouts are averaged within each network. These ratios are neither the primary estimand nor the ratio of aggregate means. \textbf {c,} Relative change in aggregate mean MSE, ensemble versus nominal, with the prespecified 97.5\% paired network-cluster bootstrap intervals (same estimates as Table 1). Negative values favour the ensemble. All networks, including influential instances, are retained; Supplementary Fig. 1 shows the complete raw difference distributions. No method-equivalence margin was specified}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Risk forecasts are evaluated on identical predictions.} The independent follow-up uses the nominal scalar recording policy, broad matched uncertainty, excluded endpoints and M=3 in 40 new networks. \textbf  {a,} Nominal (open) and ensemble (filled) mean forecast risks are paired with the same actual mean response MSE for each network; horizontal segments link the two forecasts. Axes have identical logarithmic ranges and a dashed identity line; points below the line have a forecast that exceeds the actual error. This network-aggregate comparison is descriptive, not a stand-alone calibration test. \textbf  {b,} All 40 network-level score differences, sorted; 19 favour the ensemble forecast (purple) and 21 the nominal forecast (grey). One bar (−11.7) is clipped at the axis limit and labelled. \textbf  {c,} The mean score difference with the prespecified 95\% paired network-cluster interval. Panels b and c use different horizontal and vertical scales because individual differences and uncertainty about their mean are distinct statistical objects. Scores S(v,e)=log(v)+e\textsuperscript  {2}/v are computed for individual target/truth/noise cases and then averaged within network; they are not scores of the aggregate coordinates in a. Negative differences favour the ensemble. The score evaluates an MSE functional, not a complete predictive distribution.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:4}{{4}{7}{\textbf {Risk forecasts are evaluated on identical predictions.} The independent follow-up uses the nominal scalar recording policy, broad matched uncertainty, excluded endpoints and M=3 in 40 new networks. \textbf {a,} Nominal (open) and ensemble (filled) mean forecast risks are paired with the same actual mean response MSE for each network; horizontal segments link the two forecasts. Axes have identical logarithmic ranges and a dashed identity line; points below the line have a forecast that exceeds the actual error. This network-aggregate comparison is descriptive, not a stand-alone calibration test. \textbf {b,} All 40 network-level score differences, sorted; 19 favour the ensemble forecast (purple) and 21 the nominal forecast (grey). One bar (−11.7) is clipped at the axis limit and labelled. \textbf {c,} The mean score difference with the prespecified 95\% paired network-cluster interval. Panels b and c use different horizontal and vertical scales because individual differences and uncertainty about their mean are distinct statistical objects. Scores S(v,e)=log(v)+e\textsuperscript {2}/v are computed for individual target/truth/noise cases and then averaged within network; they are not scores of the aggregate coordinates in a. Negative differences favour the ensemble. The score evaluates an MSE functional, not a complete predictive distribution}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}A separately specified forecast test separates risk estimation from point-prediction accuracy}{7}{subsection.2.3}\protected@file@percent }
\citation{ref05}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Selection effects in the exploratory model-family extension.} Relative mean-MSE changes for single-response (a) and three-response (b) objectives in eight independent 100-unit networks. Two physiological truths, two noise repetitions and three readouts are nested within each network. Markers show the ratio-of-aggregate-means effect and lines the pointwise 95\% paired network-cluster interval; filled markers denote intervals that exclude zero (four of eight settings, all favouring the ensemble). Both panels share the same effect scale; all eight prescribed settings are retained, with numerical values printed beside each interval. Negative values favour ensemble design. These comparisons are exploratory and not multiplicity-adjusted. The model family and several dynamical assumptions change together with N.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:5}{{5}{8}{\textbf {Selection effects in the exploratory model-family extension.} Relative mean-MSE changes for single-response (a) and three-response (b) objectives in eight independent 100-unit networks. Two physiological truths, two noise repetitions and three readouts are nested within each network. Markers show the ratio-of-aggregate-means effect and lines the pointwise 95\% paired network-cluster interval; filled markers denote intervals that exclude zero (four of eight settings, all favouring the ensemble). Both panels share the same effect scale; all eight prescribed settings are retained, with numerical values printed beside each interval. Negative values favour ensemble design. These comparisons are exploratory and not multiplicity-adjusted. The model family and several dynamical assumptions change together with N}{figure.5}{}}
