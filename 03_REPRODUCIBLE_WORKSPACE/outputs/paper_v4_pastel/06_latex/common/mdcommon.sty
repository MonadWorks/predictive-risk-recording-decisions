% mdcommon.sty - template-independent support for the md2tex fragments.
% Load AFTER inputenc/fontenc and the font package of the template.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mdcommon}[2026/10/17 shared support for md2tex output]
\RequirePackage{amsmath}
\makeatletter\@ifpackageloaded{newtxmath}{}{\RequirePackage{amssymb}}\makeatother
\RequirePackage{textcomp}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{newunicodechar}
\RequirePackage{url}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\newlength{\tblw} % usable width for p-column tables (set by generated code)
\setlength{\tabcolsep}{4pt}
\renewcommand{\arraystretch}{1.12}

